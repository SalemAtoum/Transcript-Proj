# Exclude all research artifacts by default
research/**

# Allow research source code and safe documentation for review
!research/
!research/**/
!research/**/*.py
!research/**/*.md
# Never publish generated meeting transcripts or metadata
research/phase7/meeting.*
research/**/meeting.json
research/**/canonical_transcript.json
